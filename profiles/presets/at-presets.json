          "title": "Carrier aggregation",
          "command": "AT^CA_INFO?"
        },
        {
          "group": "cells",
          "title": "Neighbor cells: signal level (RSRP)",
          "command": "AT$QCRSRP?"
        },
        {
          "group": "cells",
          "title": "Neighbor cells: signal quality (RSRQ)",
          "command": "AT$QCRSRQ?"
        },
        {
          "group": "cells",
          "title": "LTE category",
          "command": "AT^GETLTECAT?"
        },
        {
          "group": "modes",
