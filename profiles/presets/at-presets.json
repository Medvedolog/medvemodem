{
  "schema": "medvemodem.at-presets/1",
  "note": "AT console presets (LuCI «AT», spec 11.5). Commands are documented in docs/modem-zoo (AT-COMMANDS.md, AT-REFERENCE.md, with the sources and confidence of each); titles are ours. A preset is shown for a modem when any of its 'match' rules fits (profile id prefix, ModemManager manufacturer or model substring, VID); no 'match' means every modem. The engine marks each command with its hazard class; the console sends only what mm_at_console_refusal allows, the rest is reference. A preset's 'risk' (read_only by default, disruptive, persistent, dangerous) and its 'effects' (drops_connection, writes_nvram, requires_reboot) say what it does: LuCI asks before a disruptive or a persistent one, a dangerous one is documentation only; the engine's hazard list decides what is sent at all (the owner, 2026-11-14).",
  "groups": [
    {
      "id": "info",
      "title": "About the modem"
    },
    {
      "id": "sim",
      "title": "SIM card"
    },
    {
      "id": "network",
      "title": "Network and signal"
    },
    {
      "id": "cells",
      "title": "Cells and aggregation"
    },
    {
      "id": "modes",
      "title": "Modes and bands"
    },
    {
      "id": "data",
      "title": "Data"
    },
    {
      "id": "sms",
      "title": "SMS and USSD"
    },
    {
      "id": "hardware",
      "title": "Temperature and power"
    },
    {
      "id": "usb",
      "title": "USB composition and modes"
    },
    {
      "id": "danger",
      "title": "Dangerous: for reference only"
    }
  ],
  "sets": [
    {
      "id": "3gpp",
      "title": "Standard (3GPP 27.007)",
      "source": "3GPP TS 27.007 / 27.005",
      "presets": [
        {
          "group": "info",
          "title": "Model and firmware",
          "command": "ATI"
        },
        {
          "group": "info",
          "title": "Manufacturer",
          "command": "AT+CGMI"
        },
        {
          "group": "info",
          "title": "Model",
          "command": "AT+CGMM"
        },
        {
          "group": "info",
          "title": "Firmware version",
          "command": "AT+CGMR"
        },
        {
          "group": "sim",
          "title": "SIM state (PIN)",
          "command": "AT+CPIN?"
        },
        {
          "group": "sim",
          "title": "PIN/PUK attempts left",
          "command": "AT+CPINR"
        },
        {
          "group": "network",
          "title": "Operator and technology",
          "command": "AT+COPS?"
        },
        {
          "group": "network",
          "title": "Signal level (CSQ)",
          "command": "AT+CSQ"
        },
        {
          "group": "network",
          "title": "Signal by technology (CESQ)",
          "command": "AT+CESQ"
        },
        {
          "group": "network",
          "title": "2G/3G registration",
          "command": "AT+CREG?"
        },
        {
          "group": "network",
          "title": "LTE registration",
          "command": "AT+CEREG?"
        },
        {
          "group": "network",
          "title": "5G registration",
          "command": "AT+C5GREG?"
        },
        {
          "group": "network",
          "title": "Radio mode",
          "command": "AT+CFUN?"
        },
        {
          "group": "data",
          "title": "Access points (APN)",
          "command": "AT+CGDCONT?"
        },
        {
          "group": "data",
          "title": "Session addresses",
          "command": "AT+CGPADDR"
        },
        {
          "group": "data",
          "title": "Active sessions",
          "command": "AT+CGACT?"
        },
        {
          "group": "sms",
          "title": "SMS memory: used and total",
          "command": "AT+CPMS?"
        },
        {
          "group": "sms",
          "title": "SMS center (SMSC)",
          "command": "AT+CSCA?"
        },
        {
          "group": "sms",
          "title": "SMS format (0 PDU, 1 text)",
          "command": "AT+CMGF?"
        },
        {
          "group": "danger",
          "title": "Restart modem (\"Restart modem\" recovery step)",
          "command": "AT+CFUN=1,1",
          "risk": "dangerous",
          "effects": [
            "drops_connection",
            "requires_reboot"
          ]
        },
        {
          "group": "danger",
          "title": "Turn radio off",
          "command": "AT+CFUN=0",
          "risk": "disruptive",
          "effects": [
            "drops_connection"
          ]
        }
      ]
    },
    {
