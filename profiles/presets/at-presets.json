        {
          "group": "danger",
          "title": "Reset band masks for all technologies",
          "command": "AT^BAND_PREF",
          "risk": "dangerous",
          "effects": [
            "drops_connection",
            "writes_nvram"
          ]
        },
        {
          "group": "danger",
          "title": "Change USB composition (modem will reconnect)",
          "command": "AT^USBSWITCH=<n>",
          "risk": "dangerous",
          "effects": [
            "drops_connection",
            "writes_nvram",
            "requires_reboot"
          ]
        },
        {
          "group": "danger",
          "title": "Restart modem",
          "command": "AT+RESET",
          "risk": "dangerous",
          "effects": [
            "drops_connection",
            "requires_reboot"
          ]
        }
      ]
    },
