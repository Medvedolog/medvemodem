{
  "schema": 1,
  "id": "generic-qmi",
  "fit": "generic",
  "extends": "generic-modemmanager",
  "description": "Generic USB QMI modem",
  "match": {
    "bus": "usb",
    "drivers_any": ["qmi_wwan"]
  },
  "policy": {
    "owner_priority": ["modemmanager", "netifd-qmi"],
    "allow_direct_at_when_mm_owned": false,
    "allow_dynamic_new_id": false,
    "allow_usb_rebind": false
  },
  "hints": {
    "protocols": ["modemmanager", "qmi"]
  }
}
