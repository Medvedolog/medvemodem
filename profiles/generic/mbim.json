{
  "schema": 1,
  "id": "generic-mbim",
  "fit": "generic",
  "extends": "generic-modemmanager",
  "description": "Generic USB MBIM modem",
  "match": {
    "bus": "usb",
    "drivers_any": ["cdc_mbim"]
  },
  "policy": {
    "owner_priority": ["modemmanager", "netifd-mbim"],
    "allow_direct_at_when_mm_owned": false,
    "allow_dynamic_new_id": false,
    "allow_usb_rebind": false
  },
  "hints": {
    "protocols": ["modemmanager", "mbim"]
  }
}
