#!/bin/sh
# The fixed TTL of a modem's outgoing packets (a tariff for phones), run by medvemodemd:
#   ttl-fix [<dev> <ttl> ...]   the IPv4 TTL and IPv6 hop limit of what leaves through each <dev>
#                               become <ttl>; no pairs removes every rule
#   ttl-fix status              {"<dev>": {"ttl": N, "packets": N, "egress": true|false}, ...}
# Exit: 0 done; 3 done, but some device has no egress hook (flow offloading passes those
# rules by); 1 nft refused; 2 bad arguments.
#
# Lessons of the field, taken:
# - own tables, never an fw4 include: an include declaring fw4's chains broke the whole
#   firewall on a cold boot of OpenWrt 25.12 (no masquerade); fw4 reloads leave our tables;
# - the postrouting rule misses offloaded flows (software flow offloading forwards them from
#   the flowtable's ingress hook), so the same rule sits on the device's own egress hook,
#   which sees every packet; a kernel without it keeps the postrouting rule and says so;
# - counters in every rule: a ping from the router cannot show the TTL the operator sees.
# ICMPv6 keeps its hop limit: neighbour discovery needs 255.
# The engine runs this again after each new session: a re-created device drops its hook.

# rpcd's file exec hands the caller's environment over (LuCI's fs.exec(cmd, args, env)), and this runs as
# root: installed, nothing from that environment is taken (review 2026-10-17: a release file pointed at
# /proc/self/environ ran a line as root). The copies in the source tree keep their test overrides.
case "$0" in
/usr/libexec/medvemodem/*)
	for _v in $(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p'); do
		case "$_v" in PATH|HOME|PWD|SHLVL) ;; *) unset "$_v" 2>/dev/null ;; esac
	done
	unset _v
	export PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root ;;
esac

NFT=${MEDVEMODEM_NFT:-nft}
T=inet\ medvemodem_ttl
D=netdev\ medvemodem_ttl_dev

if [ "$1" = status ]; then
	{ $NFT list table $T; $NFT list table $D; } 2>/dev/null | awk '
		/hook egress device "/ { split($0, q, "\""); dev = q[2]; egress[dev] = 1 }
		/oifname "/ { split($0, q, "\""); dev = q[2] }
		/ttl set|hoplimit set/ {
			for (i = 1; i <= NF; i++) {
				if ($i == "packets") n = $(i + 1)
				if ($i == "set") t = $(i + 1)
			}
			if (in_dev) { ep[dev] += n } else { pp[dev] += n }
			ttl[dev] = t
		}
		/^table netdev/ { in_dev = 1 }
		END {
			printf "{"
			for (d in ttl) {
				printf "%s\"%s\": {\"ttl\": %d, \"packets\": %d, \"egress\": %s}", sep, d, ttl[d],
					(d in egress) ? ep[d] : pp[d], (d in egress) ? "true" : "false"
				sep = ", "
			}
			print "}"
		}'
	exit 0
fi

pairs=
while [ $# -gt 0 ]; do
	[ $# -ge 2 ] || { echo "ttl-fix: <dev> without a TTL" >&2; exit 2; }
	case "$1" in ''|*[!A-Za-z0-9._@-]*) echo "ttl-fix: bad device name" >&2; exit 2 ;; esac
	case "$2" in ''|*[!0-9]*) echo "ttl-fix: bad TTL" >&2; exit 2 ;; esac
	[ "$2" -ge 1 ] && [ "$2" -le 255 ] || { echo "ttl-fix: TTL out of 1..255" >&2; exit 2; }
	pairs="$pairs $1:$2"
	shift 2
done

if [ -z "$pairs" ]; then
	$NFT delete table $T 2>/dev/null
	$NFT delete table $D 2>/dev/null
	exit 0
fi

tmp=${TMPDIR:-/tmp}/medvemodem-ttl.$$
trap 'rm -f "$tmp"' EXIT
# declare, delete, declare with the rules: one transaction, first run or not
{
	echo "table $T"
	echo "delete table $T"
	echo "table $T {"
	echo "	chain postrouting {"
	echo "		type filter hook postrouting priority mangle; policy accept;"
	for p in $pairs; do
		echo "		oifname \"${p%%:*}\" counter ip ttl set ${p##*:}"
		echo "		oifname \"${p%%:*}\" meta l4proto != ipv6-icmp counter ip6 hoplimit set ${p##*:}"
	done
	echo "	}"
	echo "}"
} > "$tmp"
if ! err=$($NFT -f "$tmp" 2>&1); then
	echo "ttl-fix: nft refused the rules: $err" >&2
	exit 1
fi

# the egress hooks, one chain per device; a device the kernel cannot hook is left out
status=0 n=0
$NFT delete table $D 2>/dev/null
for p in $pairs; do
	n=$((n + 1))
	{
		echo "table $D {"
		echo "	chain egress$n {"
		echo "		type filter hook egress device \"${p%%:*}\" priority 0; policy accept;"
		echo "		meta protocol ip counter ip ttl set ${p##*:}"
		echo "		meta protocol ip6 meta l4proto != ipv6-icmp counter ip6 hoplimit set ${p##*:}"
		echo "	}"
		echo "}"
	} > "$tmp"
	if ! err=$($NFT -f "$tmp" 2>&1); then
		echo "ttl-fix: no egress hook on ${p%%:*} (offloaded connections keep their TTL): $err" >&2
		status=3
	fi
done
exit $status
