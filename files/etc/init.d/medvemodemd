#!/bin/sh /etc/rc.common
# MedveModem engine daemon (spec section 4.1).

START=60
STOP=40
USE_PROCD=1

PROG=/usr/sbin/medvemodemd

start_service() {
	local enabled settle_ms log_level host_fixes auto_recovery repair_interfaces cell_info antennas mm_poll_s auto_connect

	config_load medvemodem
	config_get_bool enabled core enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get settle_ms core settle_ms 2500
	config_get log_level core log_level info
	config_get_bool host_fixes core host_fixes 1
	config_get_bool auto_recovery core auto_recovery 1
	# a new modem with no interface connects by itself, its APN by the SIM
	config_get_bool auto_connect core auto_connect 1
	config_get_bool repair_interfaces core repair_interfaces 1
	# off by default: ModemManager's cell info and location requests hung a router (bench 2026-10-15)
	config_get_bool cell_info core cell_info 0
	# the antennas and the carriers over qmicli while a page looks; on: not what hung the router
	config_get_bool antennas core antennas 1
	# the gentle poll: a page reads ModemManager at most once in this many seconds (0 = every 15 s)
	config_get mm_poll_s core mm_poll_s 0

	procd_open_instance
	procd_set_param command "$PROG" -t "$settle_ms"
	[ "$log_level" = debug ] && procd_append_param command -d
	[ "$host_fixes" = 1 ] || procd_append_param command -F 0
	[ "$auto_recovery" = 1 ] || procd_append_param command -A 0
	[ "$repair_interfaces" = 1 ] || procd_append_param command -L 0
	procd_append_param command -c "$cell_info"
	procd_append_param command -a "$antennas"
	procd_append_param command -b "$auto_connect"
	[ "$mm_poll_s" -gt 0 ] 2>/dev/null && procd_append_param command -g "$((mm_poll_s * 1000))"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger medvemodem
}
