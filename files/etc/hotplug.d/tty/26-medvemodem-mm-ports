#!/bin/sh
# Runs after ModemManager's own 25-modemmanager-tty. A modem whose profile
# says mm_ports "control" (medvemodemd lists its USB path in mm-withhold)
# keeps its serial ports away from ModemManager: the add just reported is
# withdrawn inside ModemManager's probe delay, so it probes only the QMI/MBIM
# control port and never sends AT to the diagnostic or ADB port of a booting
# modem (bench 2026-10-07, recovery study R3). The remove also drops the port
# from ModemManager's event cache, so a restarted ModemManager does not replay it.
[ "$ACTION" = add ] || exit 0
case "$DEVNAME" in ttyUSB*|ttyACM*) ;; *) exit 0 ;; esac
list=${MEDVEMODEM_RUN_DIR:-/var/run/medvemodem}/mm-withhold
common=${MM_COMMON_SH:-/usr/share/ModemManager/modemmanager.common}
[ -s "$list" ] || exit 0
[ -r "$common" ] || exit 0
while read -r usb; do
	[ -n "$usb" ] || continue
	case "$DEVPATH" in
	*/"$usb":*)
		. "$common"
		mm_report_event remove "$DEVNAME" tty "/sys$DEVPATH"
		logger -t medvemodem "$DEVNAME of USB $usb is kept from ModemManager (profile: mm_ports control)"
		exit 0
		;;
	esac
done < "$list"
exit 0
