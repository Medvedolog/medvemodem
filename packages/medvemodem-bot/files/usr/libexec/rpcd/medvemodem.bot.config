#!/bin/sh
# rpcd executable plugin; token arrives on stdin, never on argv.
set -eu
# the secret file (tests: a scratch one; rpcd runs this with a clean environment)
FILE=${MEDVEMODEM_BOT_SECRET_FILE:-/etc/config/medvemodem-bot-secret}
case "${1:-}" in
  list)
    printf '%s\n' '{"status":{},"validate":{"token":""},"token_set":{"token":""},"token_clear":{},"transport_probe":{},"restart":{},"pair_begin":{},"pair_status":{},"pair_confirm":{},"proxy_password_set":{"password":""},"proxy_password_clear":{},"token_check":{"via":""},"proxy_check":{"section":""},"why":{},"bot_set":{"key":"","value":""},"bot_proxy_add":{"endpoint":"","username":"","password":"","title":""},"bot_proxy_set":{"section":"","enabled":""},"bot_proxy_del":{"section":""}}'
    exit 0
    ;;
  call) ;;
  *) exit 1 ;;
esac
method=${2:-}
TG=https://api.telegram.org

# curl's config for one proxy section on stdout: the password from the secret file goes through jq's stdin only
# random hex: busybox's hexdump where the image has it, else ucode (the bot's own runtime): OpenWrt 25.12's busybox may
# have no hexdump (a tester's OPiZ3, 2026-11-08)
rand_hex() {
	if command -v hexdump >/dev/null 2>&1; then
		hexdump -n "$1" -e "$1/1 \"%02x\"" /dev/urandom
	else
		ucode -e "let f = require('fs').open('/dev/urandom'); print(hexenc(f.read($1))); f.close();"
	fi
}

proxy_config() {
  ep=$(uci -q get "medvemodem-bot.$1.endpoint" 2>/dev/null || true)
  printf '%s\n' "$ep" | grep -Eqx '(socks5h|http|https)://[][A-Za-z0-9.:-]+:[0-9]{1,5}' || return 1
  user=$(uci -q get "medvemodem-bot.$1.proxy_username" 2>/dev/null || true)
  printf 'proxy = "%s"\n' "$ep"
  [ -n "$user" ] || return 0
  # a proxy added from Telegram has its own password (pw_<section>), the ones from LuCI share one
  b64=$(uci -q get "medvemodem-bot-secret.main.pw_$1" 2>/dev/null || true)
  [ -n "$b64" ] || b64=$(uci -q get medvemodem-bot-secret.main.proxy_password_b64 2>/dev/null || true)
  if [ -n "$b64" ]; then
    printf '%s\n%s\n' "$user" "$b64" | jq -Rrn '[inputs] as [$u, $b] | "proxy-user = " + (($u + ":" + ($b | @base64d)) | tojson)'
  else
    printf '%s\n%s\n' "$user" "$(uci -q get medvemodem-bot-secret.main.proxy_password 2>/dev/null || true)" |
      jq -Rrn '[inputs] as [$u, $p] | "proxy-user = " + (($u + ":" + $p) | tojson)'
  fi
}

# the routes the bot's own polling may take (routes.uc): the enabled proxy sections unless the mode is direct, then
# "direct" unless the mode is proxy or the direct fallback is off; at most three (rpcd gives a call 30 s). A check that
# went direct under «only through a proxy» told something the bot never does (second audit 2026-10-21)
routes() {
  # $1: auto (as the bot's polling), proxy (the proxy sections only), direct (no proxy at all; audit R02: «Проверить без
  # прокси» went through the proxy). The proxy sections by their priority as the bot sorts them (routes.uc), at most three
  # within rpcd's 30 s; the ones past three are counted, not hidden
  via=${1:-auto}
  mode=$(uci -q get medvemodem-bot.poll.mode 2>/dev/null || true)
  fb=$(uci -q get medvemodem-bot.poll.fallback_direct 2>/dev/null || true)
  if [ "$via" != direct ] && { [ "$mode" != direct ] || [ "$via" = proxy ]; }; then
    for sec in $(uci -q show medvemodem-bot 2>/dev/null | sed -n "s/^medvemodem-bot\.\([A-Za-z0-9_]*\)=proxy$/\1/p"); do
      [ "$(uci -q get "medvemodem-bot.$sec.enabled" 2>/dev/null)" = 1 ] || continue
      role=$(uci -q get "medvemodem-bot.$sec.role" 2>/dev/null || true)
      prio=$(uci -q get "medvemodem-bot.$sec.priority" 2>/dev/null || true)
      case "$prio" in ''|*[!0-9]*) prio=100 ;; esac
      printf '%s %03d %s\n' "$([ "$role" = primary ] && echo 0 || echo 1)" "$prio" "$sec"
    done | sort | awk '{print $3}'
  fi
  [ "$via" = direct ] && { echo direct; return 0; }
  [ "$via" = proxy ] && return 0
  [ "$mode" = direct ] || { [ "$mode" != proxy ] && [ "$fb" != 0 ]; } && echo direct
  return 0
}
# the secret file with one per-section password replaced ($2: base64, empty drops it); every other line kept as it is
secret_pw() {
  umask 077
  tmp=$(mktemp "${FILE%/*}/.medvemodem-bot-secret.XXXXXX") || return 1
  if [ -f "$FILE" ]; then grep -Ev "^[[:space:]]*option[[:space:]]+pw_$1[[:space:]]+" "$FILE" > "$tmp" || true
  else printf "config secret 'main'\n\toption token ''\n" > "$tmp"; fi
  [ -z "$2" ] || printf "\toption pw_%s '%s'\n" "$1" "$2" >> "$tmp"
  chown root:root "$tmp" && chmod 0600 "$tmp" && mv -f "$tmp" "$FILE" || { rm -f "$tmp"; return 1; }
}

# settings from Telegram (the owner, 2026-10-31): one checked way to write them for
# the bot and LuCI, only the keys below, refused when main.allow_settings is 0. CLI uci commits fire no reload trigger:
# the bot rereads its settings itself, the conversation goes on
settings_allowed() { [ "$(uci -q get medvemodem-bot.main.allow_settings 2>/dev/null)" != 0 ]; }
proxy_section() {
  printf '%s\n' "$1" | grep -Eqx '[A-Za-z0-9_]{1,32}' && [ "$(uci -q get "medvemodem-bot.$1" 2>/dev/null)" = proxy ]
}

case "$method" in
  status)
    if [ -f "$FILE" ] && uci -q get medvemodem-bot-secret.main.token | grep -Eq '^[0-9]{6,12}:[A-Za-z0-9_-]{30,}$'; then
      if uci -q get medvemodem-bot-secret.main.proxy_password_b64 >/dev/null 2>&1 || [ -n "$(uci -q get medvemodem-bot-secret.main.proxy_password 2>/dev/null || true)" ]; then pw=true; else pw=false; fi
      printf '{"token_configured":true,"proxy_password_configured":%s}\n' "$pw"
    else
      echo '{"token_configured":false}'
    fi
    ;;
  pair_begin)
    admin=$(uci -q get medvemodem-bot.primary.user_id 2>/dev/null || true)
    if printf '%s' "$admin" | grep -Eq '^[0-9]{3,20}$'; then
        echo '{"ok":false,"code":"already_configured"}'; exit 0
    fi
    token=$(uci -q get medvemodem-bot-secret.main.token 2>/dev/null || true)
    case "$token" in *:*) : ;; *) echo '{"ok":false,"code":"token_missing"}'; exit 0;; esac
    # busybox of OpenWrt has no install and no od (and on 25.12 maybe no hexdump): mkdir/chown/chmod and rand_hex
    mkdir -p /tmp/medvemodem-bot && chown root:root /tmp/medvemodem-bot && chmod 0700 /tmp/medvemodem-bot
    code=$(rand_hex 6 | tr 'abcdef' 'ABCDEF')
    [ "${#code}" -eq 12 ] || exit 1
    until=$(($(date +%s)+600))
    tmp=$(mktemp /tmp/medvemodem-bot/.pair.XXXXXX) || exit 1
    printf '{"code":"%s","until":%s}\n' "$code" "$until" > "$tmp"
    chown root:root "$tmp" && chmod 0600 "$tmp" && mv "$tmp" /tmp/medvemodem-bot/pairing.json || exit 1
    rm -f /tmp/medvemodem-bot/pair-candidate.json
    /etc/init.d/medvemodem-bot start >/dev/null 2>&1 || true
    printf '{"ok":true,"code":"%s","until":%s}\n' "$code" "$until"
    ;;
  pair_status)
    # This RPC endpoint is available only to LuCI authenticated administrators.
    path=/tmp/medvemodem-bot/pair-candidate.json
    [ -r "$path" ] || { echo '{"found":false}'; exit 0; }
    until=$(jsonfilter -i "$path" -e '@.until' 2>/dev/null || echo 0)
    case "$until" in ''|*[!0-9]*) until=0;; esac
    if [ "$until" -lt "$(date +%s)" ]; then rm -f "$path"; echo '{"found":false}'; exit 0; fi
    jsonfilter -i "$path" -e '@' 2>/dev/null | jq -c '{found:true,user_id,chat_id}' || echo '{"found":false}'
    ;;
  pair_confirm)
    path=/tmp/medvemodem-bot/pair-candidate.json
    [ -r "$path" ] || { echo '{"ok":false,"code":"no_candidate"}'; exit 0; }
    now=$(date +%s)
    until=$(jsonfilter -i "$path" -e '@.until' 2>/dev/null || echo 0)
    uid=$(jsonfilter -i "$path" -e '@.user_id' 2>/dev/null || true)
    chat=$(jsonfilter -i "$path" -e '@.chat_id' 2>/dev/null || true)
    case "$until" in ''|*[!0-9]*) until=0;; esac
    if [ "$until" -lt "$now" ] || ! printf '%s:%s' "$uid" "$chat" | grep -Eq '^[0-9]{3,20}:[0-9]{3,20}$'; then
        echo '{"ok":false,"code":"expired_or_invalid"}'; exit 0
    fi
    # Use stdin batch: identities never appear on the uci process command line.
    if printf 'set medvemodem-bot.primary.user_id=%s\nset medvemodem-bot.primary.chat_id=%s\ncommit medvemodem-bot\n' "$uid" "$chat" | uci -q batch >/dev/null 2>&1; then
      rm -f "$path" /tmp/medvemodem-bot/pairing.json
      /etc/init.d/medvemodem-bot restart >/dev/null 2>&1 || true
      echo '{"ok":true}'
    else echo '{"ok":false,"code":"uci_commit_failed"}'; fi
    ;;
  restart)
    # Restart only the bot; never call a modem or proxy manager.
    if [ ! -x /etc/init.d/medvemodem-bot ]; then
      echo '{"ok":false,"code":"service_not_installed"}'
    elif /etc/init.d/medvemodem-bot restart >/dev/null 2>&1; then
      echo '{"ok":true}'
    else
      echo '{"ok":false,"code":"service_restart_failed"}'
    fi
    ;;
  why)
    # why the bot is not running, in words for the page: the same checks as the init script
    if ubus -t 3 call medvemodem.bot status >/dev/null 2>&1; then echo '{"running":true}'; exit 0; fi
    out=$(/usr/libexec/medvemodem-bot/why 2>/dev/null) && out=''
    if [ -n "$out" ]; then
      code=${out%%	*}; words=${out#*	}
    else
      # every check passes: procd ran it and it ended; the bot's last line in the log says what stopped it
      code=exits; words='the checks passed, but the bot exited after it started'
    fi
    last=$(logread -e medvemodem-bot 2>/dev/null | tail -n 1 | sed 's/^.*medvemodem-bot[^:]*: //' | cut -c1-200)
    jq -cn --arg c "$code" --arg w "$words" --arg l "$last" '{running:false,code:$c,words:$w,last_log:$l}'
    ;;
  transport_probe)
    if [ ! -s /etc/ssl/certs/ca-certificates.crt ]; then echo '{"ok":false,"code":"ca_bundle_missing"}'
    elif [ "$(date +%s)" -lt 1790812800 ]; then echo '{"ok":false,"code":"clock_unsynced"}'
    else echo '{"ok":true,"code":"ready"}'; fi
    ;;
  proxy_password_set|proxy_password_clear)
    # Store arbitrary UTF-8 punctuation securely as ASCII base64 inside root-only
    # UCI; no secret value goes to the shell command line or stdout.
    if [ "$method" = proxy_password_set ]; then
      payload=$(head -c 4096)
      # jq, a dependency, does the base64: busybox on OpenWrt may come without its base64 applet
      encoded=$(printf '%s' "$payload" | jq -er '.password | select(type=="string" and length>=1 and length<=256 and (index("\n")==null) and (index("\r")==null) and (index("\u0000")==null)) | @base64' 2>/dev/null) || {
        echo '{"ok":false,"code":"invalid_proxy_password"}'; exit 0
      }
    else encoded=''; fi
    # the token is kept as it is: the password may come first, a token that was never set stays empty
    token=$(uci -q get medvemodem-bot-secret.main.token 2>/dev/null || true)
    printf '%s' "$token" | grep -Eq '^[0-9]{6,12}:[A-Za-z0-9_-]{30,}$' || token=''
    umask 077
    tmp=$(mktemp "${FILE%/*}/.medvemodem-bot-secret.XXXXXX") || exit 1
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    printf "config secret 'main'\n\toption token '%s'\n" "$token" > "$tmp"
    if [ -n "$encoded" ]; then printf "\toption proxy_password_b64 '%s'\n" "$encoded" >> "$tmp"; fi
    [ -f "$FILE" ] && { grep -E '^[[:space:]]*option[[:space:]]+pw_[A-Za-z0-9_]+[[:space:]]+' "$FILE" >> "$tmp" || true; }
    chown root:root "$tmp" && chmod 0600 "$tmp" && mv -f "$tmp" "$FILE" || exit 1
    echo '{"ok":true}'
    ;;
  token_set|token_clear|validate)
    payload=$(head -c 1024)
    if [ "$method" = token_clear ]; then
      token=''
    else
      # OpenWrt's default jq is built without regex (test() fails): jq takes the string, grep checks it
      token=$(printf '%s' "$payload" | jq -er '.token | select(type=="string" and (index("\n")==null))' 2>/dev/null) &&
        printf '%s\n' "$token" | grep -Eqx '[0-9]{6,12}:[A-Za-z0-9_-]{30,}' || {
        echo '{"ok":false,"code":"invalid_token"}'
        exit 0
      }
    fi
    if [ "$method" = validate ]; then echo '{"ok":true}'; exit 0; fi
    # Atomic replacement, no secret in process arguments, no log/stdout echo.
    umask 077
    tmp=$(mktemp "${FILE%/*}/.medvemodem-bot-secret.XXXXXX") || exit 1
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    # Preserve the proxy password option verbatim, including UTF-8 and punctuation.
    # No password values are ever passed in a process argument.
    printf "config secret 'main'\n\toption token '%s'\n" "$token" > "$tmp"
    if [ -f "$FILE" ]; then
        grep -E '^[[:space:]]*option[[:space:]]+(proxy_password(_b64)?|pw_[A-Za-z0-9_]+)[[:space:]]+' "$FILE" >> "$tmp" || true
    fi
    chown root:root "$tmp" && chmod 0600 "$tmp" && mv -f "$tmp" "$FILE" || exit 1
    echo '{"ok":true}'
    ;;
  token_check)
    # getMe through the bot's own routes: the token goes to curl in its config on stdin, never on a command line.
    # Success is the Bot API's own answer, ok:true with the bot's username (audit R02: an HTTP 200 of anything passed);
    # Telegram reached with another answer is said apart
    token=$(uci -q get medvemodem-bot-secret.main.token 2>/dev/null || true)
    printf '%s\n' "$token" | grep -Eqx '[0-9]{6,12}:[A-Za-z0-9_-]{30,}' || { echo '{"ok":false,"code":"token_missing"}'; exit 0; }
    via=$(head -c 1024 | jq -r '.via | select(type=="string")' 2>/dev/null || true)
    case "$via" in direct|proxy) ;; *) via=auto ;; esac
    # in the bot's own 0700 directory, not loose in /tmp (audit SEC-05, 2026-11-19)
    mkdir -p /tmp/medvemodem-bot && chmod 0700 /tmp/medvemodem-bot
    body=$(mktemp /tmp/medvemodem-bot/.check.XXXXXX) || exit 1
    trap 'rm -f "$body"' EXIT HUP INT TERM
    all=$(routes "$via"); n=0; reached=''; skipped=0
    for r in $all; do
      n=$((n + 1))
      if [ "$n" -gt 3 ]; then skipped=$((skipped + 1)); continue; fi
      if [ "$r" = direct ]; then conf='proxy = ""
noproxy = "*"'
      else conf=$(proxy_config "$r") || continue; fi
      code=$(printf '%s\nurl = "%s/bot%s/getMe"\noutput = "%s"\nwrite-out = "%%{http_code}"\nmax-time = 7\nsilent\n' \
        "$conf" "$TG" "$token" "$body" | curl -q -K - 2>/dev/null) || true
      case "$code" in
        200)
          name=$(jq -r 'select(.ok == true) | .result.username | select(type=="string")' "$body" 2>/dev/null || true)
          if printf '%s\n' "$name" | grep -Eqx '[A-Za-z0-9_]{1,64}'; then
            printf '{"ok":true,"username":"%s","via":"%s","route":"%s"}\n' "$name" "$([ "$r" = direct ] && echo direct || echo proxy)" "$r"
            exit 0
          fi
          reached=$r ;;
        401|404) echo '{"ok":false,"code":"token_rejected"}'; exit 0 ;;
        000|'') ;;
        *) reached=$r ;;
      esac
    done
    [ -n "$all" ] || { printf '{"ok":false,"code":"%s"}\n' "$([ "$via" = proxy ] && echo no_proxy || echo no_route)"; exit 0; }
    if [ -n "$reached" ]; then printf '{"ok":false,"code":"not_bot_api","route":"%s","unchecked":%d}\n' "$reached" "$skipped"
    else printf '{"ok":false,"code":"telegram_unreachable","unchecked":%d}\n' "$skipped"; fi
    ;;
  proxy_check)
    sec=$(head -c 1024 | jq -r '.section | select(type=="string")' 2>/dev/null || true)
    printf '%s\n' "$sec" | grep -Eqx '[A-Za-z0-9_]{1,64}' && [ "$(uci -q get "medvemodem-bot.$sec" 2>/dev/null)" = proxy ] ||
      { echo '{"ok":false,"code":"no_such_proxy"}'; exit 0; }
    conf=$(proxy_config "$sec") || { echo '{"ok":false,"code":"bad_endpoint"}'; exit 0; }
    # Telegram's front page: any HTTP answer through the proxy means the proxy reaches Telegram
    out=$(printf '%s\nurl = "%s/"\noutput = "/dev/null"\nwrite-out = "%%{http_code} %%{http_connect} %%{time_total}"\nmax-time = 10\nsilent\n' \
      "$conf" "$TG" | curl -q -K - 2>/dev/null) || true
    set -- $out
    if [ "${2:-}" = 407 ]; then echo '{"ok":false,"code":"proxy_auth"}'
    elif [ -z "${1:-}" ] || [ "$1" = 000 ]; then echo '{"ok":false,"code":"proxy_failed"}'
    else printf '{"ok":true,"ms":%s}\n' "$(echo "${3:-0}" | awk '{printf "%d", $1 * 1000}')"; fi
    ;;
  bot_set)
    settings_allowed || { echo '{"ok":false,"code":"settings_off"}'; exit 0; }
    in=$(head -c 1024)
    key=$(printf '%s' "$in" | jq -r '.key | select(type=="string")' 2>/dev/null || true)
    value=$(printf '%s' "$in" | jq -r '.value | select(type=="string" and (index("\n")==null))' 2>/dev/null || true)
    case "$key" in
      events.mode) case "$value" in smart|critical|all|off) ;; *) value='' ;; esac ;;
      events.enabled|events.backup|events.services|events.kernel|events.quota|events.restart|events.quiet|events.quiet_urgent)
        case "$value" in 0|1) ;; *) value='' ;; esac ;;
      events.quiet_from|events.quiet_to) printf '%s\n' "$value" | grep -Eqx '([01][0-9]|2[0-3]):[0-5][0-9]' || value='' ;;
      main.sms_forward)
        # forwarding needs SMS shown in Telegram, which only LuCI allows
        [ "$(uci -q get medvemodem-bot.main.allow_sms_content 2>/dev/null)" = 1 ] || { echo '{"ok":false,"code":"sms_off"}'; exit 0; }
        case "$value" in 0|1) ;; *) value='' ;; esac ;;
      *) echo '{"ok":false,"code":"bad_key"}'; exit 0 ;;
    esac
    [ -n "$value" ] || { echo '{"ok":false,"code":"bad_value"}'; exit 0; }
    sec=${key%%.*}
    [ "$(uci -q get "medvemodem-bot.$sec" 2>/dev/null)" ] || {
      [ "$sec" = events ] && printf 'set medvemodem-bot.events=notifications\n' | uci -q batch; }
    printf 'set medvemodem-bot.%s=%s\ncommit medvemodem-bot\n' "$key" "$value" | uci -q batch >/dev/null 2>&1 &&
      echo '{"ok":true}' || echo '{"ok":false,"code":"uci_commit_failed"}'
    ;;
  bot_proxy_add)
    settings_allowed || { echo '{"ok":false,"code":"settings_off"}'; exit 0; }
    in=$(head -c 2048)
    ep=$(printf '%s' "$in" | jq -r '.endpoint | select(type=="string" and (index("\n")==null))' 2>/dev/null || true)
    user=$(printf '%s' "$in" | jq -r '.username // "" | select(type=="string" and (index("\n")==null))' 2>/dev/null || true)
    title=$(printf '%s' "$in" | jq -r '.title // "" | select(type=="string" and (index("\n")==null))' 2>/dev/null || true)
    printf '%s\n' "$ep" | grep -Eqx '(socks5h|http|https)://([A-Za-z0-9.-]+|\[[0-9a-fA-F:]+\]):[0-9]{1,5}' ||
      { echo '{"ok":false,"code":"bad_endpoint"}'; exit 0; }
    port=${ep##*:}; [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || { echo '{"ok":false,"code":"bad_port"}'; exit 0; }
    [ -z "$user" ] || printf '%s\n' "$user" | grep -Eqx '[A-Za-z0-9_.@-]{1,80}' || { echo '{"ok":false,"code":"bad_username"}'; exit 0; }
    [ -z "$title" ] || printf '%s\n' "$title" | grep -Eqx "[^'\"\\\\]{1,32}" || { echo '{"ok":false,"code":"bad_title"}'; exit 0; }
    pw=''
    if [ -n "$user" ]; then
      pw=$(printf '%s' "$in" | jq -er '.password | select(type=="string" and length>=1 and length<=256 and (index("\n")==null) and (index("\r")==null) and (index("\u0000")==null)) | @base64' 2>/dev/null) ||
        { echo '{"ok":false,"code":"bad_password"}'; exit 0; }
    fi
    for s in $(uci -q show medvemodem-bot 2>/dev/null | sed -n "s/^medvemodem-bot\.\([A-Za-z0-9_]*\)=proxy$/\1/p"); do
      [ "$(uci -q get "medvemodem-bot.$s.endpoint" 2>/dev/null)" = "$ep" ] && { printf '{"ok":false,"code":"duplicate","section":"%s"}\n' "$s"; exit 0; }
    done
    n=1; while [ "$n" -le 20 ] && [ -n "$(uci -q get "medvemodem-bot.tg$n" 2>/dev/null)" ]; do n=$((n + 1)); done
    [ "$n" -le 20 ] || { echo '{"ok":false,"code":"too_many"}'; exit 0; }
    sec=tg$n
    # after the proxies there are: the highest priority plus 10
    prio=$(uci -q show medvemodem-bot 2>/dev/null | sed -n "s/^medvemodem-bot\.[A-Za-z0-9_]*\.priority='\{0,1\}\([0-9]*\)'\{0,1\}$/\1/p" | sort -n | tail -n 1)
    prio=$(( ${prio:-40} + 10 ))
    # checked before it is used: Telegram's front page through it, as proxy_check (a failed one is kept, switched off)
    conf=$(printf 'proxy = "%s"\n' "$ep")
    if [ -n "$user" ]; then
      conf="$conf
$(printf '%s\n%s\n' "$user" "$pw" | jq -Rrn '[inputs] as [$u, $b] | "proxy-user = " + (($u + ":" + ($b | @base64d)) | tojson)')"
    fi
    out=$(printf '%s\nurl = "%s/"\noutput = "/dev/null"\nwrite-out = "%%{http_code} %%{http_connect} %%{time_total}"\nmax-time = 8\nsilent\n' \
      "$conf" "$TG" | curl -q -K - 2>/dev/null) || true
    set -- $out
    if [ "${2:-}" = 407 ]; then check='{"ok":false,"code":"proxy_auth"}'; on=0
    elif [ -z "${1:-}" ] || [ "$1" = 000 ]; then check='{"ok":false,"code":"proxy_failed"}'; on=0
    else check=$(printf '{"ok":true,"ms":%s}' "$(echo "${3:-0}" | awk '{printf "%d", $1 * 1000}')"); on=1; fi
    if [ -n "$pw" ]; then secret_pw "$sec" "$pw" || { echo '{"ok":false,"code":"secret_write_failed"}'; exit 0; }; fi
    { printf 'set medvemodem-bot.%s=proxy\nset medvemodem-bot.%s.enabled=%s\nset medvemodem-bot.%s.role=fallback\n' "$sec" "$sec" "$on" "$sec"
      printf 'set medvemodem-bot.%s.priority=%s\nset medvemodem-bot.%s.endpoint=%s\n' "$sec" "$prio" "$sec" "$ep"
      [ -z "$user" ] || printf 'set medvemodem-bot.%s.proxy_username=%s\n' "$sec" "$user"
      [ -z "$title" ] || printf "set medvemodem-bot.%s.title='%s'\n" "$sec" "$title"
      printf 'commit medvemodem-bot\n'; } | uci -q batch >/dev/null 2>&1 || { echo '{"ok":false,"code":"uci_commit_failed"}'; exit 0; }
    printf '{"ok":true,"section":"%s","enabled":%s,"check":%s}\n' "$sec" "$([ "$on" = 1 ] && echo true || echo false)" "$check"
    ;;
  bot_proxy_set|bot_proxy_del)
    settings_allowed || { echo '{"ok":false,"code":"settings_off"}'; exit 0; }
    in=$(head -c 1024)
    sec=$(printf '%s' "$in" | jq -r '.section | select(type=="string")' 2>/dev/null || true)
    proxy_section "$sec" || { echo '{"ok":false,"code":"no_such_proxy"}'; exit 0; }
    if [ "$method" = bot_proxy_set ]; then
      on=$(printf '%s' "$in" | jq -r '.enabled | select(type=="string")' 2>/dev/null || true)
      case "$on" in 0|1) ;; *) echo '{"ok":false,"code":"bad_value"}'; exit 0 ;; esac
      printf 'set medvemodem-bot.%s.enabled=%s\ncommit medvemodem-bot\n' "$sec" "$on" | uci -q batch >/dev/null 2>&1 ||
        { echo '{"ok":false,"code":"uci_commit_failed"}'; exit 0; }
    else
      printf 'delete medvemodem-bot.%s\ncommit medvemodem-bot\n' "$sec" | uci -q batch >/dev/null 2>&1 ||
        { echo '{"ok":false,"code":"uci_commit_failed"}'; exit 0; }
      [ -z "$(uci -q get "medvemodem-bot-secret.main.pw_$sec" 2>/dev/null)" ] || secret_pw "$sec" '' || true
    fi
    echo '{"ok":true}'
    ;;
  *) exit 1 ;;
esac
