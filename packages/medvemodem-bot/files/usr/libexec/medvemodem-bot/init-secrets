#!/bin/sh
# The bot's secret file, its salt and its state directory: root's alone (the bot runs as root since r127). Also gives
# back to root what an older version gave its own user. Only busybox applets that OpenWrt 24.10 and 25.12 enable by
# default: no od, stat or install.
set -eu
S=/etc/config/medvemodem-bot-secret
D=/etc/medvemodem-bot
[ "$(id -u)" = 0 ] || exit 1
# "<mode>:<uid>:<gid>" in numbers: busybox ls cuts a long name to 8 letters in some versions, or prints none
rights() { ls -lnd "$1" | awk '{ print $1 ":" $3 ":" $4 }'; }
if [ "${1:-}" = '--check' ]; then
    [ -f "$S" ] && [ -f "$D/salt" ] || exit 1
    [ "$(rights "$S")" = "-rw-------:0:0" ] || exit 1
    [ "$(rights "$D/salt")" = "-rw-------:0:0" ] || exit 1
    exit 0
fi
# random hex: busybox's hexdump where the image has it, else ucode (the bot's own runtime): OpenWrt 25.12's busybox may
# have no hexdump (a tester's OPiZ3, 2026-11-08)
rand_hex() {
	if command -v hexdump >/dev/null 2>&1; then
		hexdump -n "$1" -e "$1/1 \"%02x\"" /dev/urandom
	else
		ucode -e "let f = require('fs').open('/dev/urandom'); print(hexenc(f.read($1))); f.close();"
	fi
}
mkdir -p "$D" "$D/state"
chown -R root:root "$D"
chmod 0700 "$D" "$D/state"
if [ ! -e "$S" ]; then
    (umask 077; printf "config secret 'main'\n\toption token ''\n\toption proxy_password ''\n" > "$S")
fi
chown root:root "$S"
chmod 0600 "$S"
if [ ! -e "$D/salt" ]; then
    (umask 077; rand_hex 32 > "$D/salt")
fi
chmod 0600 "$D/salt"
[ "$(wc -c < "$D/salt")" = 64 ] || exit 1
[ ! -d /tmp/medvemodem-bot ] || chown -R root:root /tmp/medvemodem-bot
exit 0
