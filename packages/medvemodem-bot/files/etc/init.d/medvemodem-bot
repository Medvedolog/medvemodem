#!/bin/sh /etc/rc.common
USE_PROCD=1
START=97
STOP=15

service_triggers() {
    procd_add_reload_trigger medvemodem-bot
}

start_service() {
    # Do not fork an unconfigured service into a respawn loop, and say why in words: the owner read
    # bare codes, or nothing at all for a bot switched off (2026-10-20). The checks themselves are in why
    # (configuration_token_missing, configuration_administrator_missing, secret_permissions_invalid before).
    local why
    # the package is being unpacked (its config's reload trigger fired before this file came): its postinst starts us
    [ -x /usr/libexec/medvemodem-bot/why ] || return 0
    why="$(/usr/libexec/medvemodem-bot/why)" || {
        # no words means the check itself did not run (a package half installed: CI 2026-10-20 logged «not_started_:»)
        case "$why" in *"	"*) ;; *) why="why_failed	the start check /usr/libexec/medvemodem-bot/why did not run: reinstall medvemodem-bot" ;; esac
        logger -t medvemodem-bot "not_started_${why%%	*}: ${why#*	}"
        return 0
    }
    # busybox of OpenWrt has no install
    mkdir -p /tmp/medvemodem-bot && chown root:root /tmp/medvemodem-bot && chmod 0700 /tmp/medvemodem-bot || return 1
    procd_open_instance
    procd_set_param command /usr/bin/ucode /usr/share/medvemodem-bot/main.uc
    # root, as every OpenWrt service and the engine (the owner, 2026-10-31): a user of its own needed a ubusd ACL that
    # only a SIGHUP of ubusd loads, and that HUP took the bus from rpcd and LuCI on the owner's router (r124)
    procd_set_param respawn 3600 5 3
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 7
    procd_close_instance
}
