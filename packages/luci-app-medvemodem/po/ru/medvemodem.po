msgstr "Стабильность за 24 ч"

#: htdocs/luci-static/resources/view/medvemodem/modem.js
msgid "Stable"
msgstr "Стабильно"

#: htdocs/luci-static/resources/view/medvemodem/modem.js
msgid "State monitoring"
msgstr "Контроль состояния"

