#: htdocs/luci-static/resources/view/medvemodem/modem.js
msgid "Slot %d"
msgstr "Слот %d"

#: htdocs/luci-static/resources/view/medvemodem/modem.js
msgid "Some noise"
msgstr "Есть помехи"

#: htdocs/luci-static/resources/view/medvemodem/modem.js
msgid "Someone else is logged into the modem's web interface now (from a computer, for example). MedveModem does not log in, not to throw them out: log out of the modem's web interface."
msgstr "В веб-интерфейсе модема открыт другой сеанс, например с компьютера. Завершите его: MedveModem не входит, чтобы не прервать чужой сеанс."

