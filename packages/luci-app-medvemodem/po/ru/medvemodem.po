msgstr "Режим белых списков"

#: htdocs/luci-static/resources/view/medvemodem/settings.js root/usr/share/luci/menu.d/luci-app-medvemodem.json
msgid "Whitelists"
msgstr "Белые списки"

#: htdocs/luci-static/resources/view/medvemodem/settings.js
msgid "Wired channel “%s”"
msgstr "Проводной канал «%s»"

#: htdocs/luci-static/resources/view/medvemodem/settings.js
msgid "Works again for, min"
msgstr "Снова работает, мин"

#: htdocs/luci-static/resources/view/medvemodem/settings.js
msgid "Your own scripts: put them in /etc/hotplug.d/medvemodem/. They run on a switch (ACTION=switch, DEVICE, PREVIOUS), a failover move (ACTION=failover), a modem's session up or down (ACTION=session, DEVICE_ID, STATE, INTERFACE), a recovery step, a modem's arrival or departure, and when the internet works again (ACTION=ready, DEVICE, LEVEL)."
msgstr "Разместите свои скрипты в /etc/hotplug.d/medvemodem/. Они запускаются при переключении канала (ACTION=switch, DEVICE, PREVIOUS), изменении маршрута (ACTION=failover), установке и разрыве сеанса (ACTION=session, DEVICE_ID, STATE, INTERFACE), шагах восстановления, подключении и отключении модема, а также восстановлении интернета (ACTION=ready, DEVICE, LEVEL)."

