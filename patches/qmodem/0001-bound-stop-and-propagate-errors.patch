diff --git a/application/qmodem/files/etc/init.d/qmodem_network b/application/qmodem/files/etc/init.d/qmodem_network
--- a/application/qmodem/files/etc/init.d/qmodem_network
+++ b/application/qmodem/files/etc/init.d/qmodem_network
@@ -69,54 +69,55 @@
 redial()
 {
     qmodem_valid_instance "$1" || return 2
-    hang $1
-    dial $1
-}
-
-reconfigure()
-{
-    case "$1" in ''|*[!A-Za-z0-9_]*) return 1;; esac
-    hang "$1"
-    force_stop=0
-    config_load qmodem
-    config_get g_enabled main enable_dial
-    _update_modem "$1"
-}
-
-_update_modem()
-{
-    local target
-    target=1
-    config_get enabled $1 enable_dial
-    config_get state $1 state
-    if [ "$state" = "disabled" ] || [ "$enabled" = "0" ] || [ "$g_enabled" = "0" ] || [ "$force_stop" = "1" ];then
-        target=0
-    fi
-    data=$(_procd_ubus_call list | jq -r  ".$service.instances.modem_$1")
-    [ "$data" == "null" ] && current_status=0 || current_status=1
-    logger -t qmodem_network "cfg:$1 current:$current_status;target:$target "
-    if [ "$current_status" != "$target" ];then
-        [ "$target" -eq 1 ] && dial $1 || hang $1
-        logger -t qmodem_network "update modem cfg: $1 dial:$target"
-    fi
-}
-
-_dial()
-{
-    procd_open_instance "modem_$1"
-    procd_set_param command "/usr/share/qmodem/modem_dial.sh" "$1" dial
-    procd_set_param respawn 120 15 10
-    procd_close_instance
-    logger -t qmodem_network "Modem $1 Start Dial Now"
-}
-
-_hang()
-{
-    (
-        mkdir -p "$MODEM_RUNDIR/${1}_dir"
-        exec 9>"$MODEM_RUNDIR/${1}_dir/event.lock"; flock -x 9
-        rm -f "$MODEM_RUNDIR/${1}_dir/generation" "$MODEM_RUNDIR/${1}_dir/ipv4.json" "$MODEM_RUNDIR/${1}_dir/backend.json"
-    )
+    hang "$1" || return $?
+    dial "$1"
+}
+
+reconfigure()
+{
+    qmodem_valid_instance "$1" || return 2
+    hang "$1" || return $?
+    force_stop=0
+    config_load qmodem
+    config_get g_enabled main enable_dial
+    _update_modem "$1"
+}
+
+_update_modem()
+{
+    local target
+    target=1
+    config_get enabled $1 enable_dial
+    config_get state $1 state
+    if [ "$state" = "disabled" ] || [ "$enabled" = "0" ] || [ "$g_enabled" = "0" ] || [ "$force_stop" = "1" ];then
+        target=0
+    fi
+    data=$(_procd_ubus_call list | jq -r  ".$service.instances.modem_$1")
+    [ "$data" == "null" ] && current_status=0 || current_status=1
+    logger -t qmodem_network "cfg:$1 current:$current_status;target:$target "
+    if [ "$current_status" != "$target" ];then
+        [ "$target" -eq 1 ] && dial $1 || hang $1
+        logger -t qmodem_network "update modem cfg: $1 dial:$target"
+    fi
+}
+
+_dial()
+{
+    procd_open_instance "modem_$1"
+    procd_set_param command "/usr/share/qmodem/modem_dial.sh" "$1" dial
+    procd_set_param respawn 120 15 10
+    procd_close_instance
+    logger -t qmodem_network "Modem $1 Start Dial Now"
+}
+
+_hang()
+{
+    (
+        mkdir -p "$MODEM_RUNDIR/${1}_dir"
+        exec 9>"$MODEM_RUNDIR/${1}_dir/event.lock"
+        timeout -s TERM -k 2 8 flock -x 9 || exit 124
+        rm -f "$MODEM_RUNDIR/${1}_dir/generation" "$MODEM_RUNDIR/${1}_dir/ipv4.json" "$MODEM_RUNDIR/${1}_dir/backend.json"
+    ) || return $?
     procd_kill $service "modem_$1"
     /usr/share/qmodem/modem_dial.sh "$1" hang || return $?
     logger -t qmodem_network "Modem $1 Stop Dial and Hang"
